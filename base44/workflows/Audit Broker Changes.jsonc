{
  "description": "Writes every change to a broker record to the audit log, on the server.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "audit_broker_changes",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "auditEntityChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update",
        "delete"
      ],
      "entity_name": "Broker"
    }
  },
  "name": "Audit Broker Changes"
}