{
  "name": "Reset Client Comm Timer on Update",
  "description": "Resets the Claim 48-hour client communication tracker whenever a Client Communication update is created.",
  "trigger": {
    "condition": "${ (.trigger.data.update_type == \"Client Communication\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ClaimUpdate"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "reset_client_comm_timer_on_update",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "resetClientCommTimer",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "resetClientCommTimer"
  }
}