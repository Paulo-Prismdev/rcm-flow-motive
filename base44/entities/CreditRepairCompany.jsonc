{
  "name": "CreditRepairCompany",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Credit repair company name"
    },
    "contact_name": {
      "type": "string",
      "description": "Main contact person"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "position": {
            "type": "string",
            "description": "Job title / role"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "is_primary": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Additional contacts at this company",
      "default": []
    },
    "address_line_1": {
      "type": "string",
      "description": "Street address"
    },
    "address_line_2": {
      "type": "string",
      "description": "Additional address line (optional)"
    },
    "town": {
      "type": "string",
      "description": "Town or City"
    },
    "county": {
      "type": "string",
      "description": "County or State"
    },
    "postcode": {
      "type": "string",
      "description": "Postal code"
    },
    "account_reference": {
      "type": "string",
      "description": "Account or reference number used with this credit repair company"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about this credit repair company"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}