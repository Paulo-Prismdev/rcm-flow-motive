{
  "name": "Insurer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the insurance company"
    },
    "contact_name": {
      "type": "string",
      "description": "Main contact person"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "claims_line": {
      "type": "string",
      "description": "Claims department phone number"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about this insurer"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    }
  }
}