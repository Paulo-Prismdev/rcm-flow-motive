{
  "name": "Insurer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the insurance company"
    },
    "contact_name": {
      "type": "string",
      "description": "Main contact person"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "claims_line": {
      "type": "string",
      "description": "Claims department phone number"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about this insurer"
    },
    "useful_contacts": {
      "type": "array",
      "description": "Additional useful contacts for this insurer",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "network_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Network codes associated with this insurer",
      "default": []
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.twofa_verified": true
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.twofa_verified": true
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.twofa_verified": true
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.twofa_verified": true
          }
        }
      ]
    }
  }
}