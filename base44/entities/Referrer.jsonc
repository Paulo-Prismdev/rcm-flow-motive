{
  "name": "Referrer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Referrer company name"
    },
    "logo_url": {
      "type": "string",
      "description": "URL of the company logo (JPEG or PNG)"
    },
    "contact_name": {
      "type": "string",
      "description": "Main contact person at referrer"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address_line_1": {
      "type": "string",
      "description": "Street address"
    },
    "address_line_2": {
      "type": "string",
      "description": "Additional address line (optional)"
    },
    "town": {
      "type": "string",
      "description": "Town or City"
    },
    "county": {
      "type": "string",
      "description": "County or State"
    },
    "postcode": {
      "type": "string",
      "description": "Postal code"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about this referrer"
    },
    "default_percent_to_referrer": {
      "type": "number",
      "description": "Default % fee owed to this referrer (e.g. 5 for 5%)"
    },
    "default_repairer_referral_fee": {
      "type": "number",
      "description": "Default % repairer referral fee for jobs from this referrer (e.g. 20 for 20%)"
    },
    "last_feedback_prompted_date": {
      "type": "string",
      "format": "date",
      "description": "Date when feedback was last requested from this company"
    },
    "portal_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which portal sections/features this company has access to",
      "default": [
        "Claims"
      ]
    }
  },
  "required": [
    "name",
    "contact_name",
    "phone",
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "user_type": "internal"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "id": "{{user.linked_referrer_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "user_type": "internal"
      }
    },
    "delete": {
      "user_condition": {
        "user_type": "internal"
      }
    }
  }
}