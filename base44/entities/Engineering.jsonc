{
  "name": "Engineering",
  "type": "object",
  "properties": {
    "job_number": {
      "type": "string",
      "description": "Unique job number (e.g. ENG-0001)"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this engineering job is archived"
    },
    "reference": {
      "type": "string",
      "description": "Job reference"
    },
    "status": {
      "type": "string",
      "enum": [
        "New",
        "Scheduled",
        "In Progress",
        "Report Pending",
        "Completed",
        "Cancelled"
      ],
      "default": "New"
    },
    "engineer_assigned": {
      "type": "string"
    },
    "inspection_type": {
      "type": "string",
      "enum": [
        "Pre-repair Assessment",
        "Post-repair Inspection",
        "Total Loss Assessment",
        "Engineering Report",
        "Dispute Resolution",
        "Other"
      ]
    },
    "vehicle_reg": {
      "type": "string"
    },
    "make_model": {
      "type": "string"
    },
    "vehicle_location": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the Client entity"
    },
    "client_phone": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "insurer": {
      "type": "string"
    },
    "claim_ref": {
      "type": "string"
    },
    "date_requested": {
      "type": "string",
      "format": "date"
    },
    "inspection_date": {
      "type": "string",
      "format": "date"
    },
    "report_completed_date": {
      "type": "string",
      "format": "date"
    },
    "findings": {
      "type": "string"
    },
    "recommendations": {
      "type": "string"
    },
    "report_status": {
      "type": "string",
      "enum": [
        "Not Started",
        "In Progress",
        "Completed",
        "Sent to Client"
      ],
      "default": "Not Started"
    },
    "fee": {
      "type": "number"
    },
    "linked_claim_id": {
      "type": "string"
    },
    "linked_estimate_id": {
      "type": "string"
    },
    "linked_parts_id": {
      "type": "string"
    },
    "invoice_status": {
      "type": "string",
      "enum": [
        "Not Ready for Invoicing",
        "Ready to Invoice",
        "Invoice Required - Pending",
        "Invoiced",
        "Invoice Paid",
        "Invoice Overdue",
        "Not Applicable"
      ],
      "default": "Not Ready for Invoicing"
    },
    "invoice_amount": {
      "type": "number"
    },
    "invoice_notes": {
      "type": "string"
    },
    "external_invoice_ref": {
      "type": "string"
    },
    "invoice_sent_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_payment_received": {
      "type": "string",
      "format": "date"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.client_id": "{{user.linked_client_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}