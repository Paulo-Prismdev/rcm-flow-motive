{
  "name": "ChaserEmailRule",
  "type": "object",
  "properties": {
    "rule_name": {
      "type": "string",
      "description": "Descriptive name for this rule"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this rule is currently active"
    },
    "recipient_type": {
      "type": "string",
      "enum": [
        "Client",
        "Referrer",
        "Bodyshop",
        "Insurer",
        "File Handler",
        "Custom Email"
      ],
      "description": "Who should receive the chaser email"
    },
    "custom_email": {
      "type": "string",
      "description": "If recipient_type is Custom Email, specify the email here"
    },
    "include_conditions": {
      "type": "array",
      "description": "Fire only if ALL of these conditions are true. Empty = every claim is eligible (subject to the timer). Each condition: { field, operator, value }. Enum operators: is_any_of, is_not_any_of, is_empty, is_not_empty. Boolean operator: is (value 'true'/'false'). For is_any_of/is_not_any_of, value is a comma-separated string of options.",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "operator"
        ]
      },
      "default": []
    },
    "exclude_conditions": {
      "type": "array",
      "description": "Skip the claim if ANY of these conditions are true. Same condition shape as include_conditions.",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "operator": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "operator"
        ]
      },
      "default": []
    },
    "trigger_journey_statuses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Legacy field \u2014 superseded by include_conditions. Kept for backward compatibility with rules created before the condition builder."
    },
    "total_loss_handling": {
      "type": "string",
      "enum": [
        "Include",
        "Exclude",
        "Only"
      ],
      "default": "Include",
      "description": "Legacy field \u2014 superseded by include_conditions / exclude_conditions. Kept for backward compatibility."
    },
    "trigger_timer": {
      "type": "string",
      "enum": [
        "Case 48hrs",
        "Client 48hrs",
        "Either",
        "Both"
      ],
      "default": "Case 48hrs",
      "description": "Which 48-hour update timer(s) must be overdue to trigger the chaser"
    },
    "hours_overdue_before_send": {
      "type": "number",
      "default": 0,
      "description": "How many hours after the timer goes Red (overdue) before the first chaser is sent. 0 = send immediately when overdue."
    },
    "email_subject_template": {
      "type": "string",
      "description": "Email subject with placeholders like {{claim.job_number}}"
    },
    "email_body_template": {
      "type": "string",
      "description": "Email body with placeholders for claim data"
    },
    "send_frequency": {
      "type": "string",
      "enum": [
        "Once",
        "Daily",
        "Every 3 Days",
        "Weekly"
      ],
      "default": "Daily",
      "description": "How often to repeat the chaser after the first send"
    },
    "max_sends": {
      "type": "number",
      "default": 3,
      "description": "Maximum number of chasers per claim per overdue episode"
    },
    "cc_emails": {
      "type": "string",
      "description": "Comma-separated list of CC email addresses"
    },
    "sort_order": {
      "type": "number",
      "description": "Order in which rules are displayed"
    }
  },
  "required": [
    "rule_name",
    "recipient_type",
    "trigger_timer",
    "email_subject_template",
    "email_body_template"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}