{
  "name": "Broker",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Broker company name"
    },
    "contact_name": {
      "type": "string",
      "description": "Main contact person at broker"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "description": "Broker address"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about this broker"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    }
  }
}