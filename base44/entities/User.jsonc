{
  "name": "User",
  "type": "object",
  "properties": {
    "is_super_admin": {
      "type": "boolean",
      "default": false,
      "description": "Platform super admin (full access)"
    },
    "is_company_admin": {
      "type": "boolean",
      "default": false,
      "description": "Company administrator (full company access)"
    },
    "company_id": {
      "type": "string",
      "description": "ID of the Company entity this user belongs to"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ],
      "default": "internal",
      "description": "Internal (platform owner) or external (referrer/repairer)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this user is active"
    }
  },
  "required": [
    "company_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "is_super_admin": true
          }
        },
        {
          "user_condition": {
            "is_company_admin": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "is_super_admin": true
          }
        },
        {
          "user_condition": {
            "is_company_admin": true
          }
        },
        {
          "user_condition": {
            "id": "{{user.id}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "is_super_admin": true
          }
        },
        {
          "user_condition": {
            "is_company_admin": true
          }
        },
        {
          "user_condition": {
            "id": "{{user.id}}"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "is_super_admin": true
      }
    }
  }
}