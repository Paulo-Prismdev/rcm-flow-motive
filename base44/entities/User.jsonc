{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "super_admin",
        "company_admin"
      ],
      "default": "user",
      "description": "The role of the user in the app",
      "rls": {
        "update": {
          "$or": [
            {
              "$and": [
                {
                  "$and": [
                    {
                      "user_condition": {
                        "data.user_type": "internal"
                      }
                    },
                    {
                      "user_condition": {
                        "data.twofa_verified": true
                      }
                    }
                  ]
                },
                {
                  "user_condition": {
                    "role": "super_admin"
                  }
                }
              ]
            },
            {
              "$and": [
                {
                  "$and": [
                    {
                      "user_condition": {
                        "data.user_type": "internal"
                      }
                    },
                    {
                      "user_condition": {
                        "data.twofa_verified": true
                      }
                    }
                  ]
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                }
              ]
            },
            {
              "user_condition": {
                "collaborator_role": "editor"
              }
            }
          ]
        }
      }
    },
    "company_id": {
      "type": "string",
      "description": "ID of the Company entity this user belongs to",
      "rls": {
        "update": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.user_type": "internal"
                  }
                },
                {
                  "user_condition": {
                    "data.twofa_verified": true
                  }
                }
              ]
            },
            {
              "user_condition": {
                "collaborator_role": "editor"
              }
            }
          ]
        }
      }
    },
    "user_type": {
      "type": "string",
      "enum": [
        "internal",
        "external",
        "bodyshop",
        "referrer",
        "supplier",
        "client"
      ],
      "default": "external",
      "description": "Internal (platform owner) or external (referrer/repairer). Decides internal-only access across the app, so it can only be changed by internal staff (or an app editor) - never by the user themselves.",
      "rls": {
        "update": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.user_type": "internal"
                  }
                },
                {
                  "user_condition": {
                    "data.twofa_verified": true
                  }
                }
              ]
            },
            {
              "user_condition": {
                "collaborator_role": "editor"
              }
            }
          ]
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this user is active",
      "rls": {
        "update": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.user_type": "internal"
                  }
                },
                {
                  "user_condition": {
                    "data.twofa_verified": true
                  }
                }
              ]
            },
            {
              "user_condition": {
                "collaborator_role": "editor"
              }
            }
          ]
        }
      }
    },
    "phone": {
      "type": "string",
      "description": "User phone number"
    },
    "address_line_1": {
      "type": "string",
      "description": "User address line 1"
    },
    "address_line_2": {
      "type": "string",
      "description": "User address line 2"
    },
    "town": {
      "type": "string",
      "description": "User town"
    },
    "county": {
      "type": "string",
      "description": "User county"
    },
    "postcode": {
      "type": "string",
      "description": "User postcode"
    },
    "job_title": {
      "type": "string",
      "description": "Job title for internal users"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Employment start date"
    },
    "can_manage_permissions": {
      "type": "boolean",
      "default": false,
      "description": "Can this user manage permissions for others",
      "rls": {
        "update": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.user_type": "internal"
                  }
                },
                {
                  "user_condition": {
                    "data.twofa_verified": true
                  }
                }
              ]
            },
            {
              "user_condition": {
                "collaborator_role": "editor"
              }
            }
          ]
        }
      }
    },
    "departments_access": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Dashboard",
          "Claims",
          "Estimating",
          "Engineering",
          "Parts",
          "Invoicing",
          "Reports"
        ]
      },
      "default": [],
      "description": "Departments this user has access to",
      "rls": {
        "update": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.user_type": "internal"
                  }
                },
                {
                  "user_condition": {
                    "data.twofa_verified": true
                  }
                }
              ]
            },
            {
              "user_condition": {
                "collaborator_role": "editor"
              }
            }
          ]
        }
      }
    },
    "profile_picture_url": {
      "type": "string",
      "description": "URL of user profile picture"
    },
    "emergency_contact_name": {
      "type": "string",
      "description": "Emergency contact person"
    },
    "emergency_contact_phone": {
      "type": "string",
      "description": "Emergency contact phone number"
    },
    "annual_leave_allowance": {
      "type": "number",
      "default": 25,
      "description": "Annual leave days allowance"
    },
    "annual_leave_taken": {
      "type": "number",
      "default": 0,
      "description": "Annual leave days taken"
    },
    "linked_referrer_id": {
      "type": "string",
      "description": "ID of linked Referrer entity",
      "rls": {
        "update": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.user_type": "internal"
                  }
                },
                {
                  "user_condition": {
                    "data.twofa_verified": true
                  }
                }
              ]
            },
            {
              "user_condition": {
                "collaborator_role": "editor"
              }
            }
          ]
        }
      }
    },
    "linked_contact_email": {
      "type": "string",
      "description": "Email of the specific contact this user represents within their linked referrer company"
    },
    "linked_bodyshop_id": {
      "type": "string",
      "description": "ID of linked Bodyshop entity",
      "rls": {
        "update": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.user_type": "internal"
                  }
                },
                {
                  "user_condition": {
                    "data.twofa_verified": true
                  }
                }
              ]
            },
            {
              "user_condition": {
                "collaborator_role": "editor"
              }
            }
          ]
        }
      }
    },
    "linked_supplier_id": {
      "type": "string",
      "description": "ID of linked Supplier entity",
      "rls": {
        "update": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.user_type": "internal"
                  }
                },
                {
                  "user_condition": {
                    "data.twofa_verified": true
                  }
                }
              ]
            },
            {
              "user_condition": {
                "collaborator_role": "editor"
              }
            }
          ]
        }
      }
    },
    "linked_client_id": {
      "type": "string",
      "description": "ID of linked Client entity",
      "rls": {
        "update": {
          "$or": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.user_type": "internal"
                  }
                },
                {
                  "user_condition": {
                    "data.twofa_verified": true
                  }
                }
              ]
            },
            {
              "user_condition": {
                "collaborator_role": "editor"
              }
            }
          ]
        }
      }
    },
    "notification_preferences": {
      "type": "object",
      "description": "User notification preferences",
      "additionalProperties": true
    },
    "password_user": {
      "type": "boolean",
      "default": false,
      "description": "True once this person has signed in with an email and password (not Google). Only these accounts are held to the 90-day password change. Set only by the passwordManage backend function.",
      "rls": {
        "update": false
      }
    },
    "password_changed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the password was last set through this app (change or reset). Starts the 90-day clock. Set only by the passwordManage backend function.",
      "rls": {
        "update": false
      }
    },
    "twofa_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has completed the emailed-code second step for the current sign-in. Set only by the twofaManage backend function. Staff access rules check this.",
      "rls": {
        "update": false
      }
    },
    "twofa_verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the second step was last completed. Used for the 12-hour absolute session limit.",
      "rls": {
        "update": false
      }
    },
    "twofa_last_activity_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last activity in the app. The second step lapses after 30 minutes without activity.",
      "rls": {
        "update": false
      }
    },
    "twofa_attempt_count": {
      "type": "number",
      "default": 0,
      "description": "Wrong-code attempts, counted against the user rather than one code, so asking for a new code never resets it. Back to 0 after a correct code or when a lockout ends.",
      "rls": {
        "update": false
      }
    },
    "twofa_locked_until": {
      "type": "string",
      "format": "date-time",
      "description": "After 5 wrong codes the user cannot request or enter codes until this time (15 minutes).",
      "rls": {
        "update": false
      }
    },
    "twofa_login_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the user last signed in. If this is later than twofa_verified_at, the second step must be done again.",
      "rls": {
        "update": false
      }
    },
    "twofa_initiate_lock": {
      "type": "string",
      "description": "Short-lived lock so two simultaneous requests cannot send two codes.",
      "rls": {
        "update": false
      }
    },
    "twofa_initiate_lock_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code-sending lock was taken (it lapses after 10 seconds).",
      "rls": {
        "update": false
      }
    },
    "webauthn_challenge": {
      "type": "string",
      "description": "The current Face ID / fingerprint challenge (one use, 5 minutes). Set only by the passkeyManage backend function.",
      "rls": {
        "update": false
      }
    },
    "webauthn_challenge_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Face ID / fingerprint challenge was issued.",
      "rls": {
        "update": false
      }
    },
    "webauthn_challenge_type": {
      "type": "string",
      "description": "What the challenge is for: registration (adding a device) or authentication (signing in).",
      "rls": {
        "update": false
      }
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.user_type": "internal"
                  }
                },
                {
                  "user_condition": {
                    "data.twofa_verified": true
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "internal"
              }
            },
            {
              "user_condition": {
                "data.twofa_verified": true
              }
            }
          ]
        },
        {
          "id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "$and": [
            {
              "$and": [
                {
                  "user_condition": {
                    "data.user_type": "internal"
                  }
                },
                {
                  "user_condition": {
                    "data.twofa_verified": true
                  }
                }
              ]
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        },
        {
          "id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}