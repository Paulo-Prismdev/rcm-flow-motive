{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "super_admin",
        "company_admin"
      ],
      "default": "user",
      "description": "The role of the user in the app"
    },
    "company_id": {
      "type": "string",
      "description": "ID of the Company entity this user belongs to"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "internal",
        "external",
        "bodyshop",
        "referrer",
        "supplier",
        "client"
      ],
      "default": "internal",
      "description": "Internal (platform owner) or external (referrer/repairer). Decides internal-only access across the app, so it can only be changed by internal staff (or an app editor) - never by the user themselves.",
      "rls": {
        "update": {
          "$or": [
            {
              "user_condition": {
                "data.user_type": "internal"
              }
            },
            {
              "user_condition": {
                "collaborator_role": "editor"
              }
            }
          ]
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this user is active"
    },
    "phone": {
      "type": "string",
      "description": "User phone number"
    },
    "address_line_1": {
      "type": "string",
      "description": "User address line 1"
    },
    "address_line_2": {
      "type": "string",
      "description": "User address line 2"
    },
    "town": {
      "type": "string",
      "description": "User town"
    },
    "county": {
      "type": "string",
      "description": "User county"
    },
    "postcode": {
      "type": "string",
      "description": "User postcode"
    },
    "job_title": {
      "type": "string",
      "description": "Job title for internal users"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Employment start date"
    },
    "can_manage_permissions": {
      "type": "boolean",
      "default": false,
      "description": "Can this user manage permissions for others"
    },
    "departments_access": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Dashboard",
          "Claims",
          "Estimating",
          "Engineering",
          "Parts",
          "Invoicing",
          "Reports"
        ]
      },
      "default": [],
      "description": "Departments this user has access to"
    },
    "profile_picture_url": {
      "type": "string",
      "description": "URL of user profile picture"
    },
    "emergency_contact_name": {
      "type": "string",
      "description": "Emergency contact person"
    },
    "emergency_contact_phone": {
      "type": "string",
      "description": "Emergency contact phone number"
    },
    "annual_leave_allowance": {
      "type": "number",
      "default": 25,
      "description": "Annual leave days allowance"
    },
    "annual_leave_taken": {
      "type": "number",
      "default": 0,
      "description": "Annual leave days taken"
    },
    "linked_referrer_id": {
      "type": "string",
      "description": "ID of linked Referrer entity"
    },
    "linked_contact_email": {
      "type": "string",
      "description": "Email of the specific contact this user represents within their linked referrer company"
    },
    "linked_bodyshop_id": {
      "type": "string",
      "description": "ID of linked Bodyshop entity"
    },
    "linked_supplier_id": {
      "type": "string",
      "description": "ID of linked Supplier entity"
    },
    "linked_client_id": {
      "type": "string",
      "description": "ID of linked Client entity"
    },
    "notification_preferences": {
      "type": "object",
      "description": "User notification preferences",
      "additionalProperties": true
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "company_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "company_admin"
          }
        },
        {
          "user_condition": {
            "id": "{{user.id}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "company_admin"
          }
        },
        {
          "user_condition": {
            "id": "{{user.id}}"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}