{
  "name": "User",
  "type": "object",
  "properties": {
    "is_super_admin": {
      "type": "boolean",
      "default": false,
      "description": "Platform super admin (full access)"
    },
    "is_company_admin": {
      "type": "boolean",
      "default": false,
      "description": "Company administrator (full company access)"
    },
    "company_id": {
      "type": "string",
      "description": "ID of the Company entity this user belongs to"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "internal",
        "external"
      ],
      "default": "internal",
      "description": "Internal (platform owner) or external (referrer/repairer)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this user is active"
    },
    "enabled_features": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "dashboard",
          "claims_view",
          "claims_manage",
          "jobs_view",
          "jobs_assign",
          "invoicing_view",
          "invoicing_manage",
          "reports",
          "repairer_network",
          "referrer_network",
          "user_management",
          "company_settings",
          "platform_settings",
          "billing"
        ]
      },
      "description": "Features enabled for this user (subset of company features)",
      "default": []
    },
    "linked_referrer_id": {
      "type": "string",
      "description": "ID of linked Referrer entity (for external referrer users)"
    },
    "linked_bodyshop_id": {
      "type": "string",
      "description": "ID of linked Bodyshop entity (for external repairer users)"
    },
    "linked_supplier_id": {
      "type": "string",
      "description": "ID of linked Supplier entity"
    },
    "linked_client_id": {
      "type": "string",
      "description": "ID of linked Client entity"
    },
    "linked_claim_id": {
      "type": "string",
      "description": "ID of linked Claim entity"
    },
    "departments_access": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Department access (legacy field for backward compatibility)",
      "default": []
    }
  },
  "required": [
    "company_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "is_super_admin": true
          }
        },
        {
          "user_condition": {
            "is_company_admin": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "is_super_admin": true
          }
        },
        {
          "user_condition": {
            "is_company_admin": true
          }
        },
        {
          "user_condition": {
            "id": "{{user.id}}"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "is_super_admin": true
          }
        },
        {
          "user_condition": {
            "is_company_admin": true
          }
        },
        {
          "user_condition": {
            "id": "{{user.id}}"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "is_super_admin": true
      }
    }
  }
}