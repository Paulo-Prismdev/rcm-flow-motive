{
  "name": "Part",
  "type": "object",
  "properties": {
    "job_number": {
      "type": "string",
      "description": "Unique job number (e.g. PRT-0001)"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this part request is archived"
    },
    "vehicle_ref": {
      "type": "string"
    },
    "date_requested": {
      "type": "string",
      "format": "date"
    },
    "date_ordered": {
      "type": "string",
      "format": "date",
      "description": "Date of initial order"
    },
    "date_found": {
      "type": "string",
      "format": "date"
    },
    "manufacturer": {
      "type": "string",
      "description": "Vehicle manufacturer (make only, for supplier matching)"
    },
    "make_model": {
      "type": "string",
      "description": "Combined make and model"
    },
    "vehicle_make": {
      "type": "string",
      "description": "Vehicle make from DVLA"
    },
    "vehicle_model": {
      "type": "string",
      "description": "Vehicle model from DVLA"
    },
    "vehicle_colour": {
      "type": "string",
      "description": "Vehicle colour from DVLA"
    },
    "vehicle_fuel_type": {
      "type": "string",
      "description": "Fuel type from DVLA"
    },
    "vehicle_year_of_manufacture": {
      "type": "number",
      "description": "Year vehicle was manufactured"
    },
    "vehicle_engine_capacity": {
      "type": "number",
      "description": "Engine capacity in CC"
    },
    "vehicle_co2_emissions": {
      "type": "number",
      "description": "CO2 emissions in g/km"
    },
    "vehicle_euro_status": {
      "type": "string",
      "description": "Euro emissions standard"
    },
    "vehicle_mot_status": {
      "type": "string",
      "description": "Current MOT status"
    },
    "vehicle_mot_expiry_date": {
      "type": "string",
      "format": "date",
      "description": "MOT expiry date"
    },
    "vehicle_tax_status": {
      "type": "string",
      "description": "Current tax status"
    },
    "vehicle_tax_due_date": {
      "type": "string",
      "format": "date",
      "description": "Tax due date"
    },
    "vehicle_date_of_last_v5c_issued": {
      "type": "string",
      "format": "date",
      "description": "Date last V5C was issued"
    },
    "vehicle_wheelplan": {
      "type": "string",
      "description": "Vehicle wheelplan description"
    },
    "vehicle_revenue_weight": {
      "type": "number",
      "description": "Maximum legal weight"
    },
    "part_description": {
      "type": "string"
    },
    "part_number": {
      "type": "string"
    },
    "bodyshop_company": {
      "type": "string"
    },
    "bodyshop_company_id": {
      "type": "string",
      "description": "ID of the Bodyshop entity"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_number": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "delivery_time_weeks": {
      "type": "number",
      "description": "Expected delivery time in weeks, 0 means no date"
    },
    "work_provider": {
      "type": "string"
    },
    "work_provider_id": {
      "type": "string",
      "description": "ID of the WorkProvider entity"
    },
    "courtesy_vehicle_type": {
      "type": "string",
      "enum": [
        "None",
        "Credit Hire",
        "Repairers Courtesy Vehicle",
        "Other"
      ],
      "default": "None",
      "description": "Type of courtesy vehicle arrangement"
    },
    "backorder_duration": {
      "type": "string"
    },
    "sourcing_status": {
      "type": "string",
      "enum": [
        "New Request",
        "Quoted",
        "Waiting Repairer Payment",
        "Need to Order",
        "Ordered",
        "Complete",
        "Cancelled",
        "Refund Required",
        "Needs Crediting"
      ],
      "default": "New Request"
    },
    "invoice_in": {
      "type": "boolean"
    },
    "added_to_sage": {
      "type": "boolean"
    },
    "additional_comments": {
      "type": "string"
    },
    "warranty": {
      "type": "string"
    },
    "supplier": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string",
      "description": "ID of the Supplier entity"
    },
    "part_type": {
      "type": "string",
      "enum": [
        "OEM",
        "Aftermarket",
        "Recycled",
        "Refurbished"
      ]
    },
    "delivery_time": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "New",
        "Used",
        "Refurbished"
      ]
    },
    "rrp": {
      "type": "number"
    },
    "net_price": {
      "type": "number"
    },
    "sourcing_fee": {
      "type": "number"
    },
    "courier_charge": {
      "type": "number"
    },
    "arranging_courier": {
      "type": "boolean"
    },
    "order_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Ordered",
        "In Transit",
        "Delivered",
        "Cancelled"
      ],
      "default": "Pending"
    },
    "contacted_suppliers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of supplier names that have been contacted for this part"
    },
    "suppliers_with_stock": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of supplier names that have confirmed they have this part in stock"
    },
    "linked_claim_id": {
      "type": "string"
    },
    "linked_estimate_id": {
      "type": "string"
    },
    "invoice_status": {
      "type": "string",
      "enum": [
        "Not Ready for Invoicing",
        "Ready to Invoice",
        "Invoice Required - Pending",
        "Invoiced",
        "Invoice Paid",
        "Invoice Overdue",
        "Not Applicable"
      ],
      "default": "Not Ready for Invoicing"
    },
    "invoice_amount": {
      "type": "number"
    },
    "invoice_notes": {
      "type": "string"
    },
    "external_invoice_ref": {
      "type": "string"
    },
    "invoice_sent_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_payment_received": {
      "type": "string",
      "format": "date"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "user_type": "bodyshop"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.bodyshop_company_id": "{{user.data.linked_bodyshop_id}}"
        },
        {
          "data.supplier_id": "{{user.data.linked_supplier_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}