{
  "name": "UserFeedback",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user providing feedback"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "user_type": {
      "type": "string",
      "enum": [
        "referrer",
        "bodyshop"
      ],
      "description": "Type of user providing feedback"
    },
    "rating": {
      "type": "string",
      "enum": [
        "love",
        "good",
        "ok",
        "hate"
      ],
      "description": "Sentiment rating"
    },
    "comment": {
      "type": "string",
      "description": "Optional comment, mandatory if rating is 'hate'"
    },
    "prompt_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the pop-up was shown"
    },
    "submission_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the feedback was submitted"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "user_type",
    "rating"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    }
  }
}