{
  "name": "TyreRequest",
  "type": "object",
  "properties": {
    "request_type": {
      "type": "string",
      "enum": [
        "price",
        "order"
      ],
      "description": "Whether this is a price request or an order"
    },
    "tyre_make": {
      "type": "string",
      "description": "Tyre make/model requested"
    },
    "tyre_size": {
      "type": "string",
      "description": "Tyre size requested"
    },
    "tyre_quantity": {
      "type": "number",
      "default": 1,
      "description": "Number of tyres requested"
    },
    "vehicle_reg": {
      "type": "string",
      "description": "Vehicle registration"
    },
    "vehicle_make": {
      "type": "string",
      "description": "Vehicle make"
    },
    "vehicle_model": {
      "type": "string",
      "description": "Vehicle model"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer/repairer contact name"
    },
    "customer_phone": {
      "type": "string",
      "description": "Contact phone number"
    },
    "customer_email": {
      "type": "string",
      "description": "Contact email"
    },
    "company_name": {
      "type": "string",
      "description": "Company/bodyshop name"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Processed",
        "Completed"
      ],
      "default": "Pending",
      "description": "Request status"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or requirements"
    },
    "internal_notes": {
      "type": "string",
      "description": "Internal notes for processing"
    }
  },
  "required": [
    "request_type",
    "tyre_make",
    "tyre_size"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    }
  }
}