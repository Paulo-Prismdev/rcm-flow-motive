{
  "name": "Note",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "The text content of the note."
    },
    "parent_id": {
      "type": "string",
      "description": "The ID of the parent record (Claim, Estimate, etc.) this note is attached to."
    },
    "parent_type": {
      "type": "string",
      "enum": [
        "Claim",
        "Estimate",
        "Engineering",
        "Part"
      ],
      "description": "The type of the parent record."
    },
    "parent_note_id": {
      "type": "string",
      "description": "If this is a reply, the ID of the parent note"
    },
    "update_type": {
      "type": "string",
      "description": "Category of the internal update (mirrors the Official Updates update types, minus Status Change)."
    },
    "direction": {
      "type": "string",
      "enum": [
        "Incoming",
        "Outgoing"
      ],
      "description": "Whether this internal communication was incoming or outgoing"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Phone",
        "E-Mail",
        "Whatsapp",
        "Text Message"
      ],
      "description": "Communication platform used for this internal update"
    },
    "next_steps": {
      "type": "string",
      "description": "What needs to happen next (optional, internal follow-up only \u2014 does not affect tracking)."
    },
    "due_date_for_next_action": {
      "type": "string",
      "format": "date",
      "description": "When the next internal action is due (optional)."
    },
    "starred": {
      "type": "boolean",
      "default": false,
      "description": "Whether this internal update is flagged as important"
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs of users who liked this internal update",
      "default": []
    },
    "reactions": {
      "type": "object",
      "description": "Object storing reactions with emoji as key and array of user emails as value",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "default": {}
    },
    "viewed_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who have viewed this note",
      "default": []
    },
    "tagged_users": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who are tagged/mentioned in this note",
      "default": []
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Internal documents/files attached to this note",
      "default": []
    }
  },
  "required": [
    "content",
    "parent_id",
    "parent_type"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}