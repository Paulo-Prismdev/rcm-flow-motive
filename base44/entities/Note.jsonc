{
  "name": "Note",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "The text content of the note."
    },
    "parent_id": {
      "type": "string",
      "description": "The ID of the parent record (Claim, Estimate, etc.) this note is attached to."
    },
    "parent_type": {
      "type": "string",
      "enum": [
        "Claim",
        "Estimate",
        "Engineering",
        "Part"
      ],
      "description": "The type of the parent record."
    },
    "parent_note_id": {
      "type": "string",
      "description": "If this is a reply, the ID of the parent note"
    },
    "reactions": {
      "type": "object",
      "description": "Object storing reactions with emoji as key and array of user emails as value",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "default": {}
    },
    "viewed_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who have viewed this note",
      "default": []
    },
    "tagged_users": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails who are tagged/mentioned in this note",
      "default": []
    }
  },
  "required": [
    "content",
    "parent_id",
    "parent_type"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.parent_id": "{{user.linked_claim_id}}"
        },
        {
          "data.parent_id": "{{user.linked_bodyshop_id}}"
        },
        {
          "data.parent_id": "{{user.linked_referrer_id}}"
        },
        {
          "data.parent_id": "{{user.linked_supplier_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}