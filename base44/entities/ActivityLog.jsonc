{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "parent_id": {
      "type": "string",
      "description": "ID of the parent record (Claim, Estimate, etc.)"
    },
    "parent_type": {
      "type": "string",
      "enum": [
        "Claim",
        "Estimate",
        "Engineering",
        "Part",
        "User",
        "System",
        "Client",
        "Bodyshop",
        "Insurer",
        "Broker",
        "Supplier",
        "CreditRepairCompany",
        "Referrer",
        "Company",
        "Task",
        "Settings"
      ],
      "description": "What the line is about: a claim, estimate, engineering job or part; a user account (sign-in and account events); a directory record; a task; or a settings change."
    },
    "action": {
      "type": "string",
      "description": "Type of action performed (e.g., 'Created', 'Updated', 'Status Changed', 'Note Added')"
    },
    "field_name": {
      "type": "string",
      "description": "Name of the field that was changed (if applicable)"
    },
    "old_value": {
      "type": "string",
      "description": "Previous value before change"
    },
    "new_value": {
      "type": "string",
      "description": "New value after change"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of what happened"
    },
    "user_email": {
      "type": "string",
      "description": "Email of user who performed the action"
    },
    "user_name": {
      "type": "string",
      "description": "Name of user who performed the action"
    }
  },
  "required": [
    "parent_id",
    "parent_type",
    "action",
    "description"
  ],
  "rls": {
    "create": false,
    "read": {
      "$and": [
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.twofa_verified": true
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}