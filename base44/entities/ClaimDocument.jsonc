{
  "name": "ClaimDocument",
  "type": "object",
  "properties": {
    "claim_id": {
      "type": "string",
      "description": "ID of the claim this document belongs to"
    },
    "item_key": {
      "type": "string",
      "enum": [
        "instruction_from_referrer",
        "instruction_to_repairer",
        "initial_estimate",
        "initial_authority",
        "supplementary_estimate",
        "supplementary_authority",
        "general",
        "inv_final_invoice",
        "inv_final_authority",
        "inv_collection_note",
        "inv_referrer_invoice_in",
        "inv_second_referrer_invoice_in",
        "inv_vat_excess_invoice_in",
        "inv_referral_invoice_out",
        "inv_vat_excess_invoice_out",
        "inv_cr_hire_fee",
        "inv_cr_repair_commission"
      ],
      "description": "Which checklist item this file is filed against. Keys prefixed 'inv_' belong to the internal-only Invoicing Tracker in Financials and are ignored by the Docs checklist and all portals."
    },
    "file_url": {
      "type": "string",
      "description": "Public URL of the uploaded file"
    },
    "file_name": {
      "type": "string",
      "description": "Display name for the file (renameable)"
    },
    "file_uri": {
      "type": "string",
      "description": "Private storage URI of the uploaded file (when available)"
    },
    "uploaded_by_email": {
      "type": "string",
      "description": "Email of the user who uploaded the file"
    },
    "uploaded_by_name": {
      "type": "string",
      "description": "Name of the user who uploaded the file"
    },
    "uploaded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the file was uploaded"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "instruction_pdf",
        "backfill"
      ],
      "default": "manual",
      "description": "How this document record was created"
    },
    "date_set_field": {
      "type": "string",
      "description": "Claim Key Dates field this file filled in when it landed (e.g. 'authority_received', 'date_received'). Lets a removal clear the date this file supplied, and nothing else."
    },
    "date_set_value": {
      "type": "string",
      "description": "The Key Dates value this file set, so the date is only cleared while it is still the one this file supplied."
    }
  },
  "required": [
    "claim_id",
    "item_key",
    "file_url"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}