{
  "name": "ClaimPresence",
  "type": "object",
  "description": "Who currently has a claim open. Each open claim screen keeps one record up to date every 20 seconds and removes it on close; a record not seen for over a minute is treated as gone. Used only to warn staff that a colleague is in the same claim.",
  "properties": {
    "claim_id": {
      "type": "string",
      "description": "The claim that is open."
    },
    "user_email": {
      "type": "string",
      "description": "Email of the staff member who has it open."
    },
    "user_name": {
      "type": "string",
      "description": "Display name of the staff member, shown in the warning."
    },
    "session_id": {
      "type": "string",
      "description": "One browser tab's screen, so the same person in two tabs is not shown to themselves."
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "When this screen last reported in."
    }
  },
  "required": [
    "claim_id",
    "user_email",
    "last_seen"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.twofa_verified": true
          }
        }
      ]
    },
    "read": {
      "$and": [
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.twofa_verified": true
          }
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.twofa_verified": true
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.twofa_verified": true
          }
        }
      ]
    }
  }
}