{
  "name": "PasskeyCredential",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The user this Face ID / fingerprint device belongs to"
    },
    "credential_id": {
      "type": "string",
      "description": "The passkey ID (base64url) the device presents when signing in"
    },
    "public_key": {
      "type": "string",
      "description": "The passkey public key (base64url). The private key never leaves the device."
    },
    "counter": {
      "type": "number",
      "default": 0,
      "description": "Signature counter, used to spot a cloned key"
    },
    "transports": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "How the device talks to the browser (internal, hybrid, ...)"
    },
    "rp_id": {
      "type": "string",
      "description": "The web address the passkey was made for (app.rcmautomotive.co.uk)"
    },
    "device_name": {
      "type": "string",
      "description": "A name for the device, e.g. iPhone or iPad"
    },
    "last_used_at": {
      "type": "string",
      "format": "date-time",
      "description": "When it was last used to sign in"
    },
    "backed_up": {
      "type": "boolean",
      "description": "Whether the device syncs this passkey (e.g. iCloud Keychain)"
    }
  },
  "required": [
    "user_id",
    "credential_id",
    "public_key",
    "rp_id"
  ],
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}