{
  "name": "ThirdParty",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Third party name (person or business) - the other side involved in the incident"
    },
    "party_type": {
      "type": "string",
      "enum": [
        "Individual",
        "Company"
      ],
      "default": "Individual",
      "description": "Whether this third party is an individual or a business"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address_line_1": {
      "type": "string"
    },
    "address_line_2": {
      "type": "string"
    },
    "town": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "postcode": {
      "type": "string"
    },
    "insurer": {
      "type": "string",
      "description": "The third party's own insurer"
    },
    "policy_number": {
      "type": "string",
      "description": "The third party's policy number"
    },
    "vehicle_reg": {
      "type": "string",
      "description": "Registration of the third party's vehicle, where known"
    },
    "vehicle_make_model": {
      "type": "string",
      "description": "Make and model of the third party's vehicle, where known"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "user_type": "internal"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "user_type": "internal"
      }
    },
    "delete": {
      "user_condition": {
        "user_type": "internal"
      }
    }
  }
}