{
  "name": "TimeLog",
  "type": "object",
  "properties": {
    "parent_id": {
      "type": "string",
      "description": "The ID of the parent record (Claim, Estimate, Engineering, Part)"
    },
    "parent_type": {
      "type": "string",
      "enum": [
        "Claim",
        "Estimate",
        "Engineering",
        "Part"
      ],
      "description": "The type of the parent record"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Duration in seconds"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the timer started"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the timer ended"
    },
    "log_key": {
      "type": "string",
      "description": "Stable key for one timer run (parent + start time). A repeated save updates this log instead of adding a second one, so a log is never duplicated."
    }
  },
  "required": [
    "parent_id",
    "parent_type",
    "duration_seconds",
    "started_at",
    "ended_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "internal"
              }
            },
            {
              "user_condition": {
                "data.twofa_verified": true
              }
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "internal"
              }
            },
            {
              "user_condition": {
                "data.twofa_verified": true
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "internal"
              }
            },
            {
              "user_condition": {
                "data.twofa_verified": true
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "internal"
              }
            },
            {
              "user_condition": {
                "data.twofa_verified": true
              }
            }
          ]
        }
      ]
    }
  }
}