{
  "name": "TimeLog",
  "type": "object",
  "properties": {
    "parent_id": {
      "type": "string",
      "description": "The ID of the parent record (Claim, Estimate, etc.)"
    },
    "parent_type": {
      "type": "string",
      "enum": [
        "Claim",
        "Estimate",
        "Engineering",
        "Part"
      ],
      "description": "The type of the parent record"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Duration in seconds"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the timer started"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the timer ended"
    }
  },
  "required": [
    "parent_id",
    "parent_type",
    "duration_seconds",
    "started_at",
    "ended_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        }
      ]
    }
  }
}