{
  "name": "Bodyshop",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the bodyshop/repairer"
    },
    "logo_url": {
      "type": "string",
      "description": "URL of the company logo (JPEG or PNG)"
    },
    "contact_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address_line_1": {
      "type": "string",
      "description": "Street address"
    },
    "address_line_2": {
      "type": "string",
      "description": "Additional address line (optional)"
    },
    "town": {
      "type": "string",
      "description": "Town or City"
    },
    "county": {
      "type": "string",
      "description": "County or State"
    },
    "postcode": {
      "type": "string",
      "description": "Postal code"
    },
    "latitude": {
      "type": "number",
      "description": "Geographic latitude coordinate"
    },
    "longitude": {
      "type": "number",
      "description": "Geographic longitude coordinate"
    },
    "last_feedback_prompted_date": {
      "type": "string",
      "format": "date",
      "description": "Date when feedback was last requested from this company"
    },
    "portal_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which portal sections/features this company has access to",
      "default": [
        "Claims",
        "Estimates",
        "Parts"
      ]
    }
  },
  "required": [
    "name",
    "contact_name",
    "phone",
    "email"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}