{
  "name": "Bodyshop",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the bodyshop/repairer"
    },
    "alternative_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Other names this repairer trades or invoices under — a branch or trading name. Added when a user accepts a name variation on an invoice, so that name is recognised as this repairer from then on."
    },
    "logo_url": {
      "type": "string",
      "description": "URL of the company logo (JPEG or PNG)"
    },
    "contact_name": {
      "type": "string",
      "description": "Main contact person"
    },
    "phone": {
      "type": "string",
      "description": "Landline phone number"
    },
    "mobile_phone": {
      "type": "string",
      "description": "Mobile phone number"
    },
    "email": {
      "type": "string",
      "description": "Main email address"
    },
    "full_address": {
      "type": "string",
      "description": "Full address as recorded in the master directory"
    },
    "address_line_1": {
      "type": "string",
      "description": "Street address"
    },
    "address_line_2": {
      "type": "string",
      "description": "Additional address line (optional)"
    },
    "town": {
      "type": "string",
      "description": "Town or City"
    },
    "county": {
      "type": "string",
      "description": "County or State"
    },
    "postcode": {
      "type": "string",
      "description": "Postal code"
    },
    "latitude": {
      "type": "number",
      "description": "Geographic latitude coordinate"
    },
    "longitude": {
      "type": "number",
      "description": "Geographic longitude coordinate"
    },
    "acg_signed_up": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "TBC",
        ""
      ],
      "default": "",
      "description": "Whether signed up to ACG"
    },
    "tier": {
      "type": "string",
      "description": "Network tier (e.g. TIER 1, TIER 2, Previously on Network)"
    },
    "map_group": {
      "type": "string",
      "enum": [
        "",
        "Solution",
        "QAC"
      ],
      "default": "",
      "description": "Map group assignment for visual categorization on the repairer map"
    },
    "group_name": {
      "type": "string",
      "description": "Group the bodyshop belongs to"
    },
    "bodyshop_manager": {
      "type": "string",
      "description": "Bodyshop manager name(s)"
    },
    "bs_manager_email": {
      "type": "string",
      "description": "Bodyshop manager email"
    },
    "referral_email": {
      "type": "string",
      "description": "Referral email address"
    },
    "accounts_contact": {
      "type": "string",
      "description": "Accounts contact name"
    },
    "accounts_email": {
      "type": "string",
      "description": "Accounts email address"
    },
    "web_address": {
      "type": "string",
      "description": "Website URL"
    },
    "company_registration_number": {
      "type": "string",
      "description": "Companies House registration number"
    },
    "company_directors": {
      "type": "string",
      "description": "Company director(s)"
    },
    "radius_covered": {
      "type": "string",
      "description": "Radius covered in miles"
    },
    "audatex_code": {
      "type": "string",
      "description": "Audatex code"
    },
    "bs10125_certified": {
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "TBC",
        ""
      ],
      "default": "",
      "description": "Whether BS10125 certified"
    },
    "bs10125_number": {
      "type": "string",
      "description": "BS10125 certification number"
    },
    "ico_number": {
      "type": "string",
      "description": "ICO registration number"
    },
    "vat_number": {
      "type": "string",
      "description": "VAT registration number"
    },
    "largest_vehicle_repairable": {
      "type": "string",
      "description": "Largest vehicle the bodyshop can repair"
    },
    "bodyshop_management_system": {
      "type": "string",
      "description": "Bodyshop management system used"
    },
    "wheel_alignment": {
      "type": "string",
      "enum": [
        "In House",
        "Outsourced",
        ""
      ],
      "default": "",
      "description": "Wheel alignment capability"
    },
    "adas": {
      "type": "string",
      "enum": [
        "In House",
        "Outsourced",
        ""
      ],
      "default": "",
      "description": "ADAS capability"
    },
    "jig": {
      "type": "string",
      "enum": [
        "In House",
        "Outsourced",
        ""
      ],
      "default": "",
      "description": "JIG capability"
    },
    "manufacturer_approvals": {
      "type": "string",
      "description": "Manufacturer approvals"
    },
    "insurer_approvals": {
      "type": "string",
      "description": "Insurer approvals"
    },
    "last_feedback_prompted_date": {
      "type": "string",
      "format": "date",
      "description": "Date when feedback was last requested from this company"
    },
    "courtesy_cars_offered": {
      "type": "string",
      "enum": ["Yes", "No", ""],
      "description": "Whether the repairer provides courtesy vehicles"
    },
    "courtesy_car_count": {
      "type": "string",
      "enum": ["1-5", "6-10", "10+", ""],
      "description": "Roughly how many courtesy vehicles the repairer keeps"
    },
    "courtesy_car_types": {
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "description": "Kinds of courtesy vehicle the repairer has (small car, family car, estate, SUV, prestige, electric/hybrid, automatic, van...)"
    },
    "courtesy_car_notes": {
      "type": "string",
      "description": "Anything else about the repairer's courtesy vehicles"
    },
    "pending_details_update": {
      "type": "object",
      "description": "Answers the repairer sent through the details questionnaire, waiting for staff to review: submitted_at, submitted_by_name, submitted_by_role, submitted_by_email, changes (field -> new value), notes. Cleared once reviewed."
    },
    "details_form_sent_at": {
      "type": "string",
      "description": "When the details questionnaire was last emailed to the repairer"
    },
    "details_form_sent_to": {
      "type": "string",
      "description": "Who the details questionnaire was last emailed to"
    },
    "details_last_confirmed_at": {
      "type": "string",
      "description": "When the repairer last sent their details through the questionnaire"
    },
    "portal_sections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Which portal sections/features this company has access to",
      "default": [
        "Claims",
        "Estimates",
        "Parts"
      ]
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.twofa_verified": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "internal"
              }
            },
            {
              "user_condition": {
                "data.twofa_verified": true
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "bodyshop"
              }
            },
            {
              "id": "{{user.data.linked_bodyshop_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.twofa_verified": true
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "data.user_type": "internal"
          }
        },
        {
          "user_condition": {
            "data.twofa_verified": true
          }
        }
      ]
    }
  }
}