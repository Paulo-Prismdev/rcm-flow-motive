{
  "name": "ClaimUpdate",
  "type": "object",
  "properties": {
    "claim_id": {
      "type": "string",
      "description": "ID of the claim this update belongs to"
    },
    "company_id": {
      "type": "string",
      "description": "Company ID of the user who created this update"
    },
    "update_type": {
      "type": "string",
      "enum": [
        "Status Change",
        "Client Communication",
        "Bodyshop Communication",
        "Insurer Communication",
        "Referrer Communication",
        "Credit Repair Communication",
        "Parts",
        "General Update",
        "Other"
      ],
      "default": "Other",
      "description": "Type of update - categorizes the activity"
    },
    "direction": {
      "type": "string",
      "enum": [
        "Incoming",
        "Outgoing"
      ],
      "description": "Whether this communication was incoming or outgoing"
    },
    "platform": {
      "type": "string",
      "enum": [
        "Phone",
        "E-Mail",
        "Whatsapp",
        "Text Message"
      ],
      "description": "Communication platform used for this update"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of what was done/updated"
    },
    "next_steps": {
      "type": "string",
      "description": "What needs to happen next (optional)"
    },
    "due_date_for_next_action": {
      "type": "string",
      "format": "date",
      "description": "When the next action is due (optional)"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Files attached to this update",
      "default": []
    },
    "tagged_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs of users tagged in this update",
      "default": []
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User IDs of users who liked this update",
      "default": []
    },
    "parent_update_id": {
      "type": "string",
      "description": "ID of parent update if this is a reply"
    },
    "contacted_party_name": {
      "type": "string",
      "description": "Name of the party contacted for this communication update (shown next to the update type in the header)"
    },
    "contacted_party_detail": {
      "type": "string",
      "description": "Email or phone number of the contacted party"
    },
    "starred": {
      "type": "boolean",
      "default": false,
      "description": "Whether this update is starred/flagged as important and blocks job completion until removed"
    }
  },
  "required": [
    "claim_id",
    "update_type",
    "description"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}