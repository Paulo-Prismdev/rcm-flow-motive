    "estimate_cost_gross": {
      "type": "number"
    },
    "authority_cost_gross": {
      "type": "number"
    },
    "final_repair_cost": {
      "type": "number"
    },
    "total_invoice_repairer": {
      "type": "number"
    },
    "percent_fee_optima": {
      "type": "number"
    },
    "percent_taken_factor": {
      "type": "number"
    },
    "percent_bld_invoice": {
      "type": "number"
    },
    "artura_percent": {
      "type": "number"
    },
    "total_loss_date": {
      "type": "string",
      "format": "date"
    },
    "storage_amount_net": {
      "type": "number"
    },
    "storage_amount_vat": {
      "type": "number"
    },
    "storage_invoice_repairer": {
      "type": "number"
    },
    "cancellation_date": {
      "type": "string",
      "format": "date"
    },
    "cancellation_reason": {
      "type": "string"
    },
    "date_sent_factor": {
      "type": "string",
      "format": "date"
    },
    "factored": {
      "type": "boolean"
    },
    "date_payment_in": {
      "type": "string",
      "format": "date"
    },
    "survey_status": {
      "type": "string",
      "enum": [
        "Not Sent",
        "Sent",
        "Completed",
        "No Response"
      ]
    },
    "invoice_status": {
      "type": "string",
      "enum": [
        "Not Ready for Invoicing",
        "Ready to Invoice",
        "Invoice Required - Pending",
        "Invoiced",
        "Invoice Paid",
        "Invoice Overdue",
        "Not Applicable"
      ],
      "default": "Not Ready for Invoicing"
    },
    "ready_invoice_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_notes": {
      "type": "string"
    },
    "invoice_amount": {
      "type": "number"
    },
    "external_invoice_ref": {
      "type": "string"
    },
    "invoice_sent_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_due_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_payment_received": {
      "type": "string",
      "format": "date"
    },
    "file_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Image attachments for this claim",
      "default": []
    },
    "last_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_update_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "update_status_flag": {
      "type": "string",
      "enum": [
        "Green",
        "Amber",
        "Red",
        "Blue",
        "Gray"
      ],
      "default": "Green"
    },
    "override_active": {
      "type": "boolean",
      "default": false
    },
    "override_reason": {
      "type": "string"
    },
    "override_expiry_at": {
      "type": "string",
      "format": "date-time"
    },
    "override_by_user_email": {
      "type": "string"
    },
    "override_notes": {
      "type": "string"
    },
    "requires_indemnity": {
      "type": "boolean",
      "default": false
    },
    "indemnity_driver_dob": {
      "type": "string",
      "format": "date"
    },
    "indemnity_registered_owner": {
      "type": "string"
    },
    "indemnity_pending_prosecutions": {
      "type": "string"
    },
    "indemnity_dvla_medical_restrictions": {
      "type": "string"
    },
