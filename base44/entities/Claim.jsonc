{
  "name": "Claim",
  "type": "object",
  "properties": {
    "job_number": {
      "type": "string",
      "description": "Unique job number (e.g. CLM-0001)"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "Whether this claim is archived"
    },
    "draft": {
      "type": "boolean",
      "default": false,
      "description": "Whether this claim is a draft (incomplete)"
    },
    "reg": {
      "type": "string",
      "description": "Vehicle registration number"
    },
    "job_status": {
      "type": "string",
      "description": "Primary status of the claim"
    },
    "secondary_status": {
      "type": "string",
      "description": "Secondary status for additional tracking"
    },
    "job_statuses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Array of job statuses (multi-select)"
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "Credit Repair",
        "Fault Claim",
        "Non-Fault Claim",
        "Total Loss",
        "Glass Claim"
      ]
    },
    "circumstances": {
      "type": "string"
    },
    "loss_date": {
      "type": "string",
      "format": "date",
      "description": "Date when the incident/loss occurred"
    },
    "loss_time": {
      "type": "string",
      "description": "Time when the incident/loss occurred (HH:MM format)"
    },
    "incident_location": {
      "type": "string",
      "description": "Location where the incident occurred"
    },
    "vehicle_use": {
      "type": "string",
      "enum": [
        "Business",
        "Social",
        "Commuting"
      ],
      "description": "Use of vehicle at time of incident"
    },
    "courtesy_car_required": {
      "type": "boolean"
    },
    "linked_estimate_id": {
      "type": "string"
    },
    "linked_engineering_id": {
      "type": "string"
    },
    "linked_parts_id": {
      "type": "string"
    },
    "third_party_pursuit_status": {
      "type": "string",
      "enum": [
        "N/A",
        "Awaiting Details",
        "Details Obtained",
        "Claim Created",
        "In Progress",
        "Completed"
      ],
      "default": "N/A"
    },
    "linked_third_party_claim_id": {
      "type": "string"
    },
    "linked_original_claim_id": {
      "type": "string"
    },
    "tp_capture_rejected_reason": {
      "type": "string"
    },
    "insurer": {
      "type": "string"
    },
    "claim_ref": {
      "type": "string"
    },
    "policy_number": {
      "type": "string"
    },
    "policy_excess": {
      "type": "number"
    },
    "excess_contribution_amount": {
      "type": "number"
    },
    "excess_contribution_method": {
      "type": "string",
      "enum": [
        "None",
        "Via Repairer",
        "Direct to Client"
      ],
      "default": "None"
    },
    "excess_contribution_paid": {
      "type": "boolean",
      "default": false
    },
    "excess_contribution_paid_date": {
      "type": "string",
      "format": "date"
    },
    "excess_contribution_invoice_received": {
      "type": "boolean",
      "default": false
    },
    "excess_contribution_notes": {
      "type": "string"
    },
    "referrer": {
      "type": "string"
    },
    "referrer_id": {
      "type": "string",
      "description": "ID of the Referrer or Company entity"
    },
    "referrer_ref": {
      "type": "string"
    },
    "file_handler": {
      "type": "string"
    },
    "referrer_email": {
      "type": "string"
    },
    "percent_to_referrer": {
      "type": "number"
    },
    "client_name": {
      "type": "string"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the Client entity"
    },
    "client_phone": {
      "type": "string"
    },
    "driver_contact_name": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "client_driving_license": {
      "type": "string"
    },
    "client_address_line_1": {
      "type": "string"
    },
    "client_address_line_2": {
      "type": "string"
    },
    "client_town": {
      "type": "string"
    },
    "client_county": {
      "type": "string"
    },
    "client_postcode": {
      "type": "string"
    },
    "client_vat_status": {
      "type": "string",
      "enum": [
        "VAT Registered",
        "Non-VAT",
        "Unknown"
      ]
    },
    "business_division": {
      "type": "string"
    },
    "client_lat": {
      "type": "number"
    },
    "client_lng": {
      "type": "number"
    },
    "make_model": {
      "type": "string"
    },
    "vehicle_make": {
      "type": "string"
    },
    "vehicle_model": {
      "type": "string"
    },
    "vehicle_colour": {
      "type": "string"
    },
    "vehicle_fuel_type": {
      "type": "string"
    },
    "vehicle_year_of_manufacture": {
      "type": "number"
    },
    "vehicle_engine_capacity": {
      "type": "number"
    },
    "vehicle_co2_emissions": {
      "type": "number"
    },
    "vehicle_euro_status": {
      "type": "string"
    },
    "vehicle_mot_status": {
      "type": "string"
    },
    "vehicle_mot_expiry_date": {
      "type": "string",
      "format": "date"
    },
    "vehicle_tax_status": {
      "type": "string"
    },
    "vehicle_tax_due_date": {
      "type": "string",
      "format": "date"
    },
    "vehicle_date_of_last_v5c_issued": {
      "type": "string",
      "format": "date"
    },
    "vehicle_wheelplan": {
      "type": "string"
    },
    "vehicle_revenue_weight": {
      "type": "number"
    },
    "vehicle_location": {
      "type": "string"
    },
    "vehicle_damage": {
      "type": "string"
    },
    "vehicle_type": {
      "type": "string",
      "enum": [
        "Car",
        "Van",
        "Motorcycle",
        "HGV",
        "Other"
      ]
    },
    "unroadworthy": {
      "type": "boolean"
    },
    "recovery_required": {
      "type": "boolean"
    },
    "tp_name": {
      "type": "string"
    },
    "tp_phone": {
      "type": "string"
    },
    "tp_driver_contact": {
      "type": "string"
    },
    "tp_email": {
      "type": "string"
    },
    "tp_address_line_1": {
      "type": "string"
    },
    "tp_address_line_2": {
      "type": "string"
    },
    "tp_town": {
      "type": "string"
    },
    "tp_county": {
      "type": "string"
    },
    "tp_postcode": {
      "type": "string"
    },
    "tp_vat_status": {
      "type": "string",
      "enum": [
        "VAT Registered",
        "Non-VAT",
        "Unknown"
      ]
    },
    "tp_make_model": {
      "type": "string"
    },
    "tp_reg": {
      "type": "string"
    },
    "tp_insurer": {
      "type": "string"
    },
    "tp_policy_number": {
      "type": "string"
    },
    "tp_claim_ref": {
      "type": "string"
    },
    "tp_vehicle_location": {
      "type": "string"
    },
    "tp_vehicle_damage": {
      "type": "string"
    },
    "tp_vehicle_type": {
      "type": "string",
      "enum": [
        "Car",
        "Van",
        "Motorcycle",
        "HGV",
        "Other"
      ]
    },
    "tp_unroadworthy": {
      "type": "boolean"
    },
    "tp_recovery_required": {
      "type": "boolean"
    },
    "bodyshop": {
      "type": "string"
    },
    "bodyshop_id": {
      "type": "string",
      "description": "ID of the Bodyshop entity"
    },
    "bodyshop_email": {
      "type": "string"
    },
    "repairer_accepted": {
      "type": "boolean",
      "default": false
    },
    "repairer_accepted_date": {
      "type": "string",
      "format": "date"
    },
    "instruction_pdf_url": {
      "type": "string"
    },
    "authorising_party": {
      "type": "string"
    },
    "audatex_code": {
      "type": "string"
    },
    "send_estimate_email": {
      "type": "string"
    },
    "artura_est_url": {
      "type": "string"
    },
    "est_fee": {
      "type": "number"
    },
    "referral_fee_repairer": {
      "type": "number"
    },
    "percent_bld_instruction": {
      "type": "number"
    },
    "last_file_update": {
      "type": "string",
      "format": "date-time"
    },
    "last_client_update": {
      "type": "string",
      "format": "date-time"
    },
    "latest_update": {
      "type": "string"
    },
    "date_received": {
      "type": "string",
      "format": "date"
    },
    "estimate_completed": {
      "type": "string",
      "format": "date"
    },
