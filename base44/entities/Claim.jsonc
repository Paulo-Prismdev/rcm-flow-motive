    "all_parts_on_site": {
      "type": "string",
      "format": "date"
    },
    "ecd": {
      "type": "string",
      "format": "date"
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    },
    "invoice_received_repairer": {
      "type": "string",
      "format": "date"
    },
    "invoice_sent_referrer": {
      "type": "string",
      "format": "date"
    },
    "estimate_cost_net": {
      "type": "number"
    },
    "authority_cost_net": {
      "type": "number"
