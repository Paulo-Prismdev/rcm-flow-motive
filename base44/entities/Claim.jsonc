    },
    "instruction_contact_name": {
      "type": "string",
      "description": "Contact name used on the instruction PDF, captured at allocation time"
    },
    "instruction_contact_email": {
      "type": "string",
      "description": "Contact email used on the instruction PDF, captured at allocation time"
    },
    "instruction_contact_phone": {
      "type": "string",
      "description": "Contact phone used on the instruction PDF, captured at allocation time"
    }
