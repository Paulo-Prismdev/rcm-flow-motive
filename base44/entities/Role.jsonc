{
  "name": "Role",
  "type": "object",
  "properties": {
    "role_name": {
      "type": "string",
      "description": "Name of the role (e.g., Claims Handler, Estimator, Parts Manager)"
    },
    "description": {
      "type": "string",
      "description": "Description of what this role does"
    },
    "departments_access": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Dashboard",
          "Claims",
          "Estimating",
          "Engineering",
          "Parts",
          "Invoicing",
          "Map"
        ]
      },
      "description": "Default department access for users with this role",
      "default": [
        "Dashboard"
      ]
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this role is currently in use"
    }
  },
  "required": [
    "role_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.user_type": "internal"
      }
    },
    "read": {
      "user_condition": {
        "data.user_type": "internal"
      }
    },
    "update": {
      "user_condition": {
        "data.user_type": "internal"
      }
    },
    "delete": {
      "user_condition": {
        "data.user_type": "internal"
      }
    }
  }
}