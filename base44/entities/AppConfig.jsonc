{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "config_key": {
      "type": "string",
      "description": "Unique key for the config (e.g., 'company_logo')"
    },
    "config_value": {
      "type": "string",
      "description": "Value of the config (e.g., URL for logo)"
    }
  },
  "required": [
    "config_key"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "internal"
              }
            },
            {
              "user_condition": {
                "data.twofa_verified": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "data.can_manage_permissions": true
              }
            }
          ]
        }
      ]
    },
    "read": {
      "user_condition": {}
    },
    "update": {
      "$and": [
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "internal"
              }
            },
            {
              "user_condition": {
                "data.twofa_verified": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "data.can_manage_permissions": true
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "$and": [
            {
              "user_condition": {
                "data.user_type": "internal"
              }
            },
            {
              "user_condition": {
                "data.twofa_verified": true
              }
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "super_admin"
              }
            },
            {
              "user_condition": {
                "data.can_manage_permissions": true
              }
            }
          ]
        }
      ]
    }
  }
}