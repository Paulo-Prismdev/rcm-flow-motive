{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Client full name or company name"
    },
    "client_type": {
      "type": "string",
      "enum": [
        "Individual",
        "Company"
      ],
      "default": "Individual",
      "description": "Whether this client is an individual or a company"
    },
    "company_contact_name": {
      "type": "string",
      "description": "Primary contact name (Company clients only)"
    },
    "company_contact_phone": {
      "type": "string",
      "description": "Primary contact phone (Company clients only)"
    },
    "company_contact_email": {
      "type": "string",
      "description": "Primary contact email (Company clients only)"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address_line_1": {
      "type": "string",
      "description": "Street address"
    },
    "address_line_2": {
      "type": "string",
      "description": "Additional address line (optional)"
    },
    "town": {
      "type": "string",
      "description": "Town or City"
    },
    "county": {
      "type": "string",
      "description": "County"
    },
    "postcode": {
      "type": "string",
      "description": "Postal code"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about this client"
    },
    "latitude": {
      "type": "number",
      "description": "Geographic latitude coordinate"
    },
    "longitude": {
      "type": "number",
      "description": "Geographic longitude coordinate"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "id": "{{user.linked_client_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "id": "{{user.linked_client_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}