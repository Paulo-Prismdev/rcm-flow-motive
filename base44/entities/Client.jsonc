{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the person or company in the directory"
    },
    "is_client": {
      "type": "boolean",
      "default": true,
      "description": "Client tag. True when the record is (or has been) the client on a claim. Legacy records with both tags unset are read as clients."
    },
    "is_third_party": {
      "type": "boolean",
      "default": false,
      "description": "Third party tag. True when the record is (or has been) the third party on a claim. A record can carry both tags."
    },
    "client_type": {
      "type": "string",
      "enum": [
        "Individual",
        "Company"
      ],
      "default": "Individual",
      "description": "Whether this person/company is an individual or a business"
    },
    "company_contact_name": {
      "type": "string",
      "description": "Primary contact name (Company records only) \u2014 legacy field, superseded by contacts array"
    },
    "company_contact_phone": {
      "type": "string",
      "description": "Primary contact phone (Company records only) \u2014 legacy field, superseded by contacts array"
    },
    "company_contact_email": {
      "type": "string",
      "description": "Primary contact email (Company records only) \u2014 legacy field, superseded by contacts array"
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "position": {
            "type": "string",
            "description": "Job title / role"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "is_primary": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "description": "Contacts at this business \u2014 client-only, shown only while the record carries the Client tag",
      "default": []
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address_line_1": {
      "type": "string",
      "description": "Street address"
    },
    "address_line_2": {
      "type": "string",
      "description": "Additional address line (optional)"
    },
    "town": {
      "type": "string",
      "description": "Town or City"
    },
    "county": {
      "type": "string",
      "description": "County"
    },
    "postcode": {
      "type": "string",
      "description": "Postal code"
    },
    "vat_status": {
      "type": "string",
      "enum": [
        "VAT Registered",
        "Non-VAT",
        "Unknown"
      ],
      "default": "Unknown",
      "description": "VAT registration status \u2014 client-only setting"
    },
    "handles_vat_excess": {
      "type": "boolean",
      "default": false,
      "description": "We handle this client's VAT and excess. Client-only: their claims show the VAT & Excess invoice items in the Financials tracker. Only applies while the record carries the Client tag."
    },
    "insurer": {
      "type": "string",
      "description": "The third party's own insurer \u2014 third-party detail"
    },
    "policy_number": {
      "type": "string",
      "description": "The third party's policy number \u2014 third-party detail"
    },
    "vehicle_reg": {
      "type": "string",
      "description": "Registration of the third party's vehicle, where known \u2014 third-party detail"
    },
    "vehicle_make_model": {
      "type": "string",
      "description": "Make and model of the third party's vehicle, where known \u2014 third-party detail"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes about this record"
    },
    "latitude": {
      "type": "number",
      "description": "Geographic latitude coordinate"
    },
    "longitude": {
      "type": "number",
      "description": "Geographic longitude coordinate"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "user_type": "internal"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "user_type": "internal"
          }
        },
        {
          "user_condition": {
            "user_type": "referrer"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "user_type": "internal"
      }
    },
    "delete": {
      "user_condition": {
        "user_type": "internal"
      }
    }
  }
}