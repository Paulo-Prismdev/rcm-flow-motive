{
  "name": "EmailTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "subject": {
      "type": "string",
      "description": "Email subject line"
    },
    "body": {
      "type": "string",
      "description": "Email body template with placeholders"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "Claim",
        "Estimate",
        "Engineering",
        "Part",
        "General"
      ],
      "description": "Which item type this template is for"
    },
    "description": {
      "type": "string",
      "description": "Optional description of when to use this template"
    }
  },
  "required": [
    "name",
    "subject",
    "body",
    "item_type"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": null,
    "delete": null
  }
}